# Copy this file to .env and fill in your real values.
# The backend and agent scripts load this file automatically (dotenv).

# Required for the cross-encoder reranking step.
# Get a free key at https://dashboard.cohere.com/api-keys
# If this is missing, the pipeline skips reranking and falls back to RRF order.
COHERE_API_KEY=your_cohere_api_key_here
